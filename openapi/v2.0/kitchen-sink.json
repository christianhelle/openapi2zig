{
  "swagger": "2.0",
  "info": {
    "title": "Kitchen Sink",
    "description": "A specification that exercises every Swagger 2.0 model type in the parser.",
    "termsOfService": "https://example.com/terms",
    "contact": {
      "name": "API Team",
      "url": "https://example.com/support",
      "email": "api@example.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "produces": ["application/json", "application/xml"],
  "externalDocs": {
    "description": "Find out more",
    "url": "https://example.com/docs"
  },
  "tags": [
    {
      "name": "items",
      "description": "Item operations",
      "externalDocs": { "url": "https://example.com/docs/items" }
    }
  ],
  "security": [{ "apiKeyAuth": [] }, { "oauth2Implicit": ["read:items"] }],
  "securityDefinitions": {
    "basicAuth": { "type": "basic", "description": "Basic authentication" },
    "apiKeyAuth": {
      "type": "apiKey",
      "name": "X-API-Key",
      "in": "header",
      "description": "API key authentication"
    },
    "apiKeyQuery": { "type": "apiKey", "name": "api_key", "in": "query" },
    "oauth2Implicit": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://example.com/oauth/authorize",
      "scopes": { "read:items": "Read items" }
    },
    "oauth2Password": {
      "type": "oauth2",
      "flow": "password",
      "tokenUrl": "https://example.com/oauth/token",
      "scopes": { "read:items": "Read items" }
    },
    "oauth2Application": {
      "type": "oauth2",
      "flow": "application",
      "tokenUrl": "https://example.com/oauth/token",
      "scopes": { "write:items": "Write items" }
    },
    "oauth2AccessCode": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://example.com/oauth/authorize",
      "tokenUrl": "https://example.com/oauth/token",
      "scopes": { "read:items": "Read items", "write:items": "Write items" }
    }
  },
  "parameters": {
    "PageSize": {
      "name": "pageSize",
      "in": "query",
      "description": "Items per page",
      "type": "integer",
      "format": "int32"
    }
  },
  "responses": {
    "NotFound": {
      "description": "The item was not found",
      "schema": { "$ref": "#/definitions/Error" }
    }
  },
  "paths": {
    "x-vendor-extension": { "ignored": true },
    "/items": {
      "parameters": [
        {
          "name": "traceId",
          "in": "header",
          "type": "string",
          "description": "Correlation id"
        }
      ],
      "get": {
        "tags": ["items"],
        "summary": "List items",
        "description": "Returns every item",
        "operationId": "listItems",
        "externalDocs": { "url": "https://example.com/docs/list-items" },
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "schemes": ["https"],
        "deprecated": false,
        "security": [{ "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "tags",
            "in": "query",
            "description": "Tags to filter by",
            "required": false,
            "type": "array",
            "collectionFormat": "multi",
            "allowEmptyValue": true,
            "items": {
              "type": "array",
              "collectionFormat": "csv",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[a-z]+$",
                "maxLength": 32,
                "minLength": 1,
                "maximum": 10.0,
                "exclusiveMaximum": false,
                "minimum": 1.0,
                "exclusiveMinimum": false,
                "maxItems": 5,
                "minItems": 1,
                "uniqueItems": true,
                "multipleOf": 1.0,
                "default": "a",
                "enum": ["a", "b"]
              }
            }
          },
          {
            "name": "count",
            "in": "query",
            "type": "integer",
            "maximum": 100,
            "exclusiveMaximum": false,
            "minimum": 0,
            "exclusiveMinimum": false,
            "multipleOf": 2,
            "maxLength": 3,
            "minLength": 1,
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": false,
            "pattern": "^[0-9]+$",
            "default": 10,
            "enum": [10, 20]
          }
        ],
        "responses": {
          "200": {
            "description": "A list of items",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Item" } },
            "headers": {
              "X-Rate-Limit": {
                "type": "integer",
                "format": "int32",
                "description": "Requests left in the window"
              }
            },
            "examples": { "application/json": [] }
          },
          "404": { "$ref": "#/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "createItem",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "The item to create",
            "required": true,
            "schema": { "$ref": "#/definitions/Item" }
          }
        ],
        "responses": { "201": { "description": "Created" } }
      },
      "put": {
        "operationId": "replaceItems",
        "parameters": [
          { "name": "file", "in": "formData", "type": "file", "description": "Payload" }
        ],
        "responses": { "200": { "description": "Replaced" } }
      },
      "delete": {
        "operationId": "deleteItems",
        "responses": { "204": { "description": "Deleted" } }
      },
      "options": {
        "operationId": "itemOptions",
        "responses": { "200": { "description": "Allowed methods" } }
      },
      "head": {
        "operationId": "itemHead",
        "responses": { "200": { "description": "Headers only" } }
      },
      "patch": {
        "operationId": "patchItems",
        "responses": { "200": { "description": "Patched" } }
      }
    },
    "/ping": {
      "$ref": "#/paths/~1items"
    }
  },
  "definitions": {
    "Item": {
      "title": "Item",
      "type": "object",
      "description": "A purchasable item",
      "discriminator": "kind",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "uuid", "readOnly": true },
        "name": { "type": "string", "maxLength": 64, "minLength": 1, "pattern": "^[a-z]+$" },
        "count": {
          "type": "integer",
          "multipleOf": 2.0,
          "maximum": 100.0,
          "exclusiveMaximum": false,
          "minimum": 0.0,
          "exclusiveMinimum": false
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10,
          "minItems": 0,
          "uniqueItems": true
        },
        "extra": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "maxProperties": 5,
          "minProperties": 1
        },
        "status": { "type": "string", "enum": ["new", "done"], "default": "new" }
      },
      "example": { "id": "b0a1", "name": "kettle" },
      "externalDocs": { "url": "https://example.com/docs/item" },
      "xml": { "name": "item", "namespace": "https://example.com/ns", "prefix": "ex", "attribute": false, "wrapped": true }
    },
    "Combo": {
      "allOf": [{ "$ref": "#/definitions/Item" }, { "type": "object" }]
    },
    "Error": {
      "type": "object",
      "properties": {
        "message": { "type": "string" }
      }
    }
  }
}
