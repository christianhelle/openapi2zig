{
  "openapi": "3.2.0",
  "info": {
    "title": "Converter Edge Cases",
    "description": "allOf merging, cookie parameters, content-typed parameters and unknown schema types.",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          { "name": "session", "in": "cookie", "schema": { "type": "string" } },
          { "name": "elsewhere", "in": "somewhere", "schema": { "type": "string" } },
          {
            "name": "filter",
            "in": "query",
            "content": {
              "application/json": { "schema": { "type": "string" } }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Merged" } }
            }
          },
          "400": {
            "description": "a report rather than JSON",
            "content": {
              "text/csv": { "schema": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Base": {
        "type": "object",
        "required": ["id", "shared"],
        "properties": {
          "id": { "type": "string" },
          "shared": { "type": "string" },
          "replaced": { "type": "integer" }
        }
      },
      "Extra": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "extra": { "type": "string" }
        }
      },
      "Merged": {
        "allOf": [
          { "$ref": "#/components/schemas/Base" },
          { "$ref": "#/components/schemas/Extra" },
          {
            "type": "object",
            "properties": {
              "inline_prop": { "type": "string" }
            }
          }
        ],
        "properties": {
          "replaced": { "type": "string" },
          "own": { "type": "boolean" }
        }
      },
      "Mystery": { "type": "weird" }
    }
  }
}
