//! Signs the app in with a client secret and prints the size of the access
//! token. Set the variables below, for example in your shell:
//!
//!     zig build run-client_credentials
//!
//! Never put the secret in source code.

const std = @import("std");
const sdk = @import("{{name}}");

pub fn main(init: std.process.Init) !void {
{{oauth_env_lines}}    const client_id = init.environ_map.get("CLIENT_ID") orelse return error.MissingClientId;
    const client_secret = init.environ_map.get("CLIENT_SECRET") orelse return error.MissingClientSecret;

    var credentials = try sdk.clientCredentials(init.gpa, init.io, &.{
{{oauth_params_literal}}    }, client_id, client_secret);
    defer credentials.deinit();

    var client = sdk.initWithTokenProvider(init.gpa, init.io, credentials.tokenProvider(sdk.TokenProvider));
    defer client.deinit();

    const token = client.token_provider.?.getToken(init.gpa, init.io) catch |err| {
        if (credentials.last_error) |message| std.debug.print("Sign in failed: {s}\n", .{message});
        return err;
    };
    defer init.gpa.free(token);
    std.debug.print("Signed in; the access token has {d} characters\n", .{token.len});
}
